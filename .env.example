# ==============================================================================
# Local Worker Configuration (.env)
# Copy this file to .env and customize for your machine.
# ==============================================================================

# Central Cloud Server URL
LAB_URL=https://ee-auto.up.railway.app

# Worker Authentication Token (Required to claim jobs)
LAB_TOKEN=replace-with-your-worker-token

# Unique Worker Name for this device (e.g. windows-pc-1, macmini-office, etc.)
# If left empty, will default to computer hostname.
WORKER_NAME=windows-pc-1

# Job types to claim on this device (comma-separated):
# - ping          : Proof-of-life and IP verification
# - gmap.scan     : Google Maps business scanner
# - agy.ask       : Antigravity CLI research runner (YOLO mode)
# - agy.probe     : Antigravity session health check
# - chatgpt.ask   : ChatGPT research runner
# - chatgpt.probe : ChatGPT session check
# - research.contact : research-contact Agent Skill runner
# - research.probe   : research-contact dependency/session health check
#
# Examples:
# All-in-one:
# WORKER_TYPES=ping,gmap.scan,agy.ask,agy.probe,research.contact,research.probe
# Maps scan only:
# WORKER_TYPES=ping,gmap.scan
# Contact research only (requires Pi + the installed research-contact skill):
# WORKER_TYPES=research.contact,research.probe
WORKER_TYPES=ping,gmap.scan,agy.ask,agy.probe

# Research-contact overrides (optional; also read by the /setup checklist)
# RESEARCH_AGENT_BIN=pi
# RESEARCH_CONTACT_SKILL_DIR=C:\\path\\to\\research-contact
# RESEARCH_CONTACT_TIMEOUT_MS=900000
# PDFTOTEXT_BIN=C:\\path\\to\\pdftotext.exe
# SCRAPLING_MCP_BIN=C:\\path\\to\\scrapling-mcp.exe
# OBSCURA_BIN=C:\\path\\to\\obscura.exe
# UVX_BIN=C:\\path\\to\\uvx.exe
# MCPORTER_BIN=C:\\path\\to\\mcporter.cmd

# Number of parallel lanes for agy jobs (default: 2)
AGY_LANES=2

# Parallel Pi contact-research lanes on this machine. Default 1, hard ceiling 3.
# RESEARCH_LANES=3

# Local read-only operations dashboard (loopback by default)
WORKER_DASHBOARD_PORT=18788
WORKER_DASHBOARD_HOST=127.0.0.1
# Set WORKER_DASHBOARD_DISABLE=1 to turn it off.
# Do not bind this to a public interface without adding your own access control.

# (Optional) Custom Path to Chrome binary if not installed in default location:
# Windows default auto-detected: C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS default auto-detected: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# (Optional) Custom Path to Antigravity CLI if not in PATH or ~/.local/bin:
# AGY_BIN=C:\Users\YourUser\.local\bin\agy.cmd

# (Optional) Railway PostgreSQL Database Proxy (for saving Google Maps scan results)
PG_PROXY_URL=https://pg-proxy-production.up.railway.app
PG_DB_NAME=pg_2nd
PG_PROXY_TOKEN=
