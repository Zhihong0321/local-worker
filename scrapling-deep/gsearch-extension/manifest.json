{
  "manifest_version": 3,
  "name": "gsearch bridge",
  "version": "1.0.0",
  "description": "Lets the local-worker run Google searches in this Chrome and returns the results as JSON.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "alarms", "storage"],
  "host_permissions": ["https://www.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "gsearch bridge" }
}
